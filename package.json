{
  "name": "@logrift/client",
  "version": "0.1.0",
  "description": "Buffered TypeScript client for the Logrift log collector",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/logrift/javascript.git"
  },
